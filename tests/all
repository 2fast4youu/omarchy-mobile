#!/bin/bash
# SPDX-License-Identifier: MIT
# The installer's tests (no phone, nothing flashed): tools/install-phone
# against a fake fastboot, tools/phone-provision against a synthetic backup
# (and a container standing in for the phone, with Docker), the initramfs's
# first-boot growth, the bring-up overlays, the simplefb trigger, the storage guard's packed
# allowlist and the USB product string, the blueline v0 boot-image packing,
# the postmarketOS USB gadget sequence and the panel block, the reference
# enumeration runner (does the known-good distro image enumerate at all),
# bin/omamobile's boot-image layouts
# and flash against a fake fastboot, omamobile-firstboot's own tests, and the
# smoke test of the newest root image in out/ if there is one, and the
# felix device package's own test, and the FLASH-BEREIT block's guard
# (tests/flash-block: every hash, size, path, expectation line and collect-file
# name in the block is checked against the disk and the runner, because that
# block is what survives a context compaction and a stale number in it would
# send the flash at the wrong image).
#
# NOTE 2026-10-30: the runners are an EXPLICIT list below. A new tests/<name>
# file is picked up by the parse loop's tests/* glob but never RUNS unless it is
# named here -- measured when tests/flash-block parsed cleanly and stayed silent
# for a whole suite pass.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
for f in tools/install-phone tools/phone-provision tools/build-rootfs tools/build-packages tools/make-bundle \
         tools/lib/alarm.sh tools/lib/alarm-setup rootfs/build-inside tests/*; do
  [[ -f $f ]] || continue   # tests/owl is the OWL conformance suite's folder
  if head -1 "$f" | grep -q "^#!.*python"; then python3 -c "import ast,sys;ast.parse(open(sys.argv[1],encoding='utf-8').read())" "$f" ' ' || { echo "not ok - $f parst" >&2; exit 1; }
  else bash -n "$f" || { echo "not ok - $f parst" >&2; exit 1; }
  fi
done
sh -n initramfs/init
sh -n device/flame/initramfs/init
sh -n device/flame/initramfs/build
bash -n tools/build-flame-probe
echo "ok - scripts parse"
for t in tests/pr-check tests/kernel-pr-check tests/install-phone tests/phone-provision tests/initramfs-grow tests/images-layout tests/device-overlays tests/simplefb-trigger tests/storage-guard tests/usb-product tests/boot-method tests/bootimg-v0 tests/gadget-reference tests/gadget-modules tests/ref-enumeration tests/bisection tests/flash-block tests/flame-probe packages/omamobile-firstboot/test/all packages/omamobile-device-felix/test/all; do
  echo "# $t"
  "$t"
done
shopt -s nullglob
latest=""
for f in out/omamobile-rootfs-*-aarch64.img.zst; do latest=$f; done
if [[ -n $latest ]]; then
  echo "# tests/rootfs-smoke $latest"
  tests/rootfs-smoke "$latest"
else
  echo "ok - # skip: no root image in out/ for tests/rootfs-smoke (tools/build-rootfs)"
fi
