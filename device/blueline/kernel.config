# SPDX-License-Identifier: MIT
# blueline (Pixel 3, sdm845): Display, Speicher und USB eingebaut, keine
# Fremd-GPU-Treiber. UFS/PHY muessen =y sein, sonst findet der Kernel die
# Wurzel nicht, weil unsere Initramfs keine Module nachlaedt.

CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_PANEL=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_LG_SW43408=y

CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_QCOM_LLCC=y

CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_F_NCM=m
CONFIG_USB_F_ACM=m
CONFIG_USB_U_SERIAL=m
CONFIG_USB_U_ETHER=m

# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_XE is not set
