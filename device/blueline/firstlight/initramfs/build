#!/bin/sh
# SPDX-License-Identifier: MIT
# Runs inside device/blueline/firstlight/build's disposable aarch64 Alpine
# container: builds the first-light initramfs and the header-v2 boot image.
# Never connects to or writes a phone.
set -eu
apk add --no-cache cpio gzip dtc python3

[ "$(fdtget /input/blueline.dtb / model)" = 'Google Pixel 3' ] || {
    echo 'Not a Google Pixel 3 device tree' >&2; exit 1;
}
case " $(fdtget /input/blueline.dtb / compatible) " in
    *google,blueline*qcom,sdm845*) ;;
    *) echo 'Not a google,blueline / qcom,sdm845 device tree' >&2; exit 1 ;;
esac
gzip -t /input/kernel || { echo 'Expected a gzip-compressed ARM64 Image' >&2; exit 1; }
gzip -dc /input/kernel > /tmp/Image
python3 - <<'PY'
import sys
from pathlib import Path
with Path('/tmp/Image').open('rb') as stream:
    stream.seek(56)
    if stream.read(4) != b'ARM\x64':
        sys.exit('Kernel has no ARM64 Image header')
PY
release=$(strings /tmp/Image | sed -n 's/^Linux version \([^ ]*\) .*/\1/p' | head -1)
[ -n "$release" ] || { echo 'No Linux version string in the kernel' >&2; exit 1; }
echo "Kernel release: $release"
rm /tmp/Image

stage=/tmp/rootfs
mkdir -p "$stage"
apk --root "$stage" --initdb --no-cache \
    --repositories-file /etc/apk/repositories --keys-dir /etc/apk/keys add \
    alpine-baselayout busybox dropbear iproute2 util-linux busybox-extras
install -m755 /src/device/blueline/firstlight/initramfs/init "$stage/init"
mkdir -p "$stage/root/.ssh" "$stage/proc" "$stage/sys" "$stage/dev" "$stage/run"
cp /input/key.pub "$stage/root/.ssh/authorized_keys"
chmod 700 "$stage/root/.ssh"
chmod 600 "$stage/root/.ssh/authorized_keys"

# The guard's allowlist ships EMPTY: first light writes nothing. init also
# fails closed if this file is missing or non-empty.
: > "$stage/etc/omamobile-ufs-rw"

# The gadget's product string comes from the descriptor's NAME.
# (busybox tr has no [:print:] class - it deletes the literal characters
# "[ :pint"; use the printable-ASCII octal range instead.)

# Panic probe (opt-in via the builder's --panic-probe SECONDS): makes the
# kernel panic while it is provably alive, so its warm reboot returns the
# handset to FASTBOOT MODE within ~60 s - the only aliveness instrument
# on a handset with no panel driver, no gadget and no ABOOT fetch.
if [ -n "${OMAMOBILE_PANIC_PROBE:-}" ]; then
    printf '%s\n' "$OMAMOBILE_PANIC_PROBE" > "$stage/etc/omamobile-panic-probe"
fi
if [ -n "${OMAMOBILE_NO_GADGET:-}" ]; then
    : > "$stage/etc/omamobile-nogadget"
fi
name=$(sed -n 's/^NAME=//p' /src/device/blueline/device.conf | head -1 \
    | tr -d '"' | tr -cd '\040-\176')
if [ -n "$name" ]; then
    printf '%s\n' "$name" > "$stage/etc/omamobile-usb-product"
fi

# No vendor firmware and no kernel modules enter first light: the kernel
# build carries everything needed built-in.
(cd "$stage" && find . -print0 | cpio --null --quiet -o -H newc --owner=0:0) \
    | gzip -n -9 > /out/initramfs.cpio.gz

# ABOOT on this generation is proven at exactly these offsets (BRINGUP-M1
# Sources: postmarketOS deviceinfo for google-blueline): base 0, kernel at
# 0x8000, ramdisk at 0x1000000, tags at 0x100, 4 KiB pages, board DTB
# appended (--dtb, not the second stage: append_dtb, no QCDT).
# --kernel_offset 0x0: ABOOT (b1c1-0.4) liest den arm64 Image-Header und
# prueft kernel_addr gegen das text_offset-Feld des Kernels; mainline
# arm64-Kernel seit 6.x haben text_offset=0, ein Header mit 0x8000
# quittiert ABOOT beim RAM-Boot mit "KernelDecompress failed: Invalid
# Parameter / Kernel TextOffset does not match" (pmaports !3932, UART-Log
# 2023-03-28; mobile-nixos !361 derselbe Fix). Stock-RQ3A paescht, weil
# Googles Kernel dort noch mit 0x8000 gebaut wird.
#
# The DTB rides at the END of the kernel blob (cat kernel dtb), NOT in the
# v2 DTB section: on 2026-10-27 header-section packing died silently in
# ~4 s on every boot, while the concatenated layout (the pmaports blueline
# recipe, deviceinfo_append_dtb=true) kept the kernel alive past 2 min on
# the first try. AOSP mkbootimg refuses an empty --dtb and wants v2 to
# carry one, so the check is patched out in a local copy and --dtb is not
# passed at all.
cat /input/kernel /input/blueline.dtb > /kernel-dtb
cp -r /mkbootimg /tmp/mkbootimg
sed -i "s/raise ValueError(.DTB image must not be empty..)/pass/" /tmp/mkbootimg/mkbootimg.py
# Shell-expanded BEFORE mkbootimg sees it: a ${VAR} written inside the
# single-quoted --cmdline would ride into the boot image as literal text.
cmdline='console=ttyMSM0,115200n8 console=tty0 loglevel=8 printk.devkmsg=on panic=10 androidboot.hardware=qcom androidboot.board=blueline'
[ -n "${OMAMOBILE_EXTRA_CMDLINE:-}" ] && cmdline="$cmdline $OMAMOBILE_EXTRA_CMDLINE"
extra_knob="${OMAMOBILE_EXTRA_CMDLINE:-}"
python3 /tmp/mkbootimg/mkbootimg.py --header_version 2 \
    --base 0x0 --kernel_offset 0x00000000 --ramdisk_offset 0x01000000 \
    --tags_offset 0x100 --pagesize 4096 \
    --kernel /kernel-dtb --ramdisk /out/initramfs.cpio.gz \
    --cmdline "$cmdline" \
    -o /out/firstlight.img
# The debug knobs must be byte-verifiable in the shipped image: assert the
# exact strings landed in the v2 header's cmdline field.
python3 - <<PY
import sys
d = open('/out/firstlight.img','rb').read(4096)
cmd = d[64:1024].split(b'\x00')[0].decode()
print('cmdline:', cmd)
if 'panic=10' not in cmd:
    sys.exit('cmdline lost panic=10')
extra = '''$extra_knob'''
if extra and extra not in cmd:
    sys.exit('cmdline lost extra knob ' + repr(extra))
PY
size=$(stat -c %s /out/firstlight.img)
[ "$size" -le 67108864 ] || { rm /out/firstlight.img; echo 'Image exceeds the 64 MiB boot partition budget (M1.0 getvar confirms the real size)' >&2; exit 1; }
(cd /out && sha256sum firstlight.img initramfs.cpio.gz > SHA256SUMS)
