#!/bin/sh
# SPDX-License-Identifier: MIT
# Pixel 3 RAM-only first light. Never mount or write Android storage.
#
# Modelled on the Pixel 4 first light (device/flame/initramfs/init) but for
# this gate the guard is absolute: an EMPTY allowlist ships with the image
# and init fails closed, so even userdata, boot_b and dtbo_b stay read-only.
# No modules are loaded, no watchdog is taken over, no rootfs handoff runs.
#
# Bring-up order (2026-10-27): this handset's kernel died within ~5 s on
# each of three boots, so the ACM console is set up FIRST and every later
# step marks itself in /run/steps.log (flushed to the ACM port as soon as
# it exists) plus a 2 s heartbeat. The last marker and last beat before
# the silence localize the death; the previous boot's panic text comes out
# of the ramoops region as this boot's first ACM output.
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

steps=/run/steps.log
mark() {
    echo "[$(cut -d. -f1 /proc/uptime)s] step: $*" >> "$steps" 2>/dev/null
    echo "omamobile-blueline: $*" > /dev/kmsg
}

# Mounts are soft during bring-up: a failure is logged, and the step that
# needs the mount checks for itself. PID 1 staying alive is what delivers
# the pstore crash log, so it must not exit on a failed mount.
mark 'begin'
mount -t proc proc /proc || mark 'mount proc FAILED'
mkdir -p /run
mount -t tmpfs tmpfs /run || mark 'mount tmpfs FAILED'
mount -t sysfs sysfs /sys || mark 'mount sysfs FAILED'
mount -t devtmpfs devtmpfs /dev || mark 'mount devtmpfs FAILED'
mkdir -p /dev/pts /sys/fs/pstore /config
mount -t devpts devpts /dev/pts || mark 'mount devpts FAILED'
mount -t configfs configfs /config || mark 'mount configfs FAILED'
mark "kernel $(uname -r) $(uname -m)"

say() {
    echo "omamobile-blueline: $*" > /dev/kmsg
    echo "omamobile-blueline: $*" > /dev/console 2>/dev/null
}
echo 'Omarchy Mobile first-light (blueline) - RAM only' > /dev/console 2>/dev/null

# The gadget first: the ACM console and NCM link are the only instruments
# on this handset (no UART breakout).
mark 'usb gadget setup'
product='Omarchy Mobile'
[ -s /etc/omamobile-usb-product ] && product=$(cat /etc/omamobile-usb-product)
g=/config/usb_gadget/omamobile
mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" 2>/dev/null
echo 0x1d6b > "$g/idVendor" 2>/dev/null
echo 0x0104 > "$g/idProduct" 2>/dev/null
echo 'Omarchy Mobile' > "$g/strings/0x409/manufacturer" 2>/dev/null
echo "$product" > "$g/strings/0x409/product" 2>/dev/null
echo omamobile-blueline > "$g/strings/0x409/serialnumber" 2>/dev/null
echo 'NCM + ACM' > "$g/configs/c.1/strings/0x409/configuration" 2>/dev/null
mkdir -p "$g/functions/ncm.usb0" "$g/functions/acm.GS0" 2>/dev/null
ln -s "$g/functions/ncm.usb0" "$g/configs/c.1/" 2>/dev/null
ln -s "$g/functions/acm.GS0" "$g/configs/c.1/" 2>/dev/null

udc=""
for _ in $(seq 1 30); do
    for controller in /sys/class/udc/*; do
        [ -e "$controller" ] && udc=${controller##*/} && break
    done
    [ -n "$udc" ] && break
    sleep 1
done
if [ -n "$udc" ]; then
    mark "binding UDC $udc"
    echo "$udc" > "$g/UDC" 2>/dev/null && mark 'UDC bound' || mark 'UDC bind FAILED'
else
    mark 'no UDC appeared in 30 s'
fi

# Once ttyGS0 exists: flush the step log, dump the previous boot's pstore
# (the crash evidence), then beat every 2 s. Sudden silence after the last
# beat is itself the measurement. Every 10 s the same evidence goes to the
# raw boot_a log channel (logflush, defined below and resolved at call
# time): if the panel and USB both stay dark, the partition tail is the
# only survivor of a later ABOOT timeout reset.
(
    while [ ! -e /proc/uptime ]; do sleep 0.2; done
    # Dump the previous boot's crash log to kmsg (panel) and to ttyGS0 (ACM).
    if mount -t pstore pstore /sys/fs/pstore 2>/dev/null; then
        for f in /sys/fs/pstore/*; do
            [ -e "$f" ] || continue
            echo "===== PSTORE ${f##*/} begin =====" > /dev/kmsg
            cat "$f" > /dev/kmsg 2>/dev/null
            echo "===== PSTORE ${f##*/} end =====" > /dev/kmsg
        done
    else
        echo 'omamobile-blueline: pstore mount failed' > /dev/kmsg
    fi
    _n=0
    while :; do
        up=$(cut -d. -f1 /proc/uptime)
        echo "omamobile-blueline: beat ${up}s steps:$(tail -1 "$steps" 2>/dev/null)" > /dev/kmsg
        if [ -e /dev/ttyGS0 ]; then
            cat "$steps" 2>/dev/null > /dev/ttyGS0 2>/dev/null
            echo "beat ${up}s" > /dev/ttyGS0 2>/dev/null
        fi
        _n=$((_n + 1))
        if [ $((_n % 5)) -eq 0 ]; then logflush 2>/dev/null; fi
        sleep 2
    done
) &

mark 'network bring-up'
ip link set lo up

# Raw log channel (bring-up instrument, 2026-10-27): this handset shows no
# panel text and no USB enumeration yet, and boots return to ABOOT after
# ~2 min. The last 1 MiB of the 64 MiB boot_a partition is free space of
# our own image, so init flushes its whole evidence bag there; after any
# reset `fastboot fetch boot_a 63 1` recovers it (dd at 63 MiB, padded
# with NUL, grep -a OMAMOBILE-LOG). Only that one block device is flipped
# rw around a write, back to ro immediately; userdata and the other LUNs
# are never touched. Block devices can appear late, so wait for the
# by-partlabel link before declaring the channel dead.
bootdev=""
find_bootdev() {
    for l in /dev/disk/by-partlabel/boot_a /dev/disk/by-name/boot_a; do
        [ -e "$l" ] || continue
        bootdev=$(basename "$(readlink -f "$l")")
        return 0
    done
    return 1
}
logflush() {
    find_bootdev || return 1
    d=/dev/$bootdev
    {
        echo "===== OMAMOBILE-LOG v1 up=$(cut -d. -f1 /proc/uptime)s ====="
        cat "$steps" 2>/dev/null
        echo "--- udcs ---"; ls /sys/class/udc 2>/dev/null
        echo "--- deferred ---"; cat /sys/devices/postponed_probe 2>/dev/null; cat /sys/kernel/debug/devices_deferred 2>/dev/null
        echo "--- gadget ---"; ls "$g" 2>/dev/null; cat "$g/UDC" 2>/dev/null
        echo "--- fb/vt ---"; ls /dev/fb0 /dev/tty0 2>/dev/null; cat /sys/class/vtconsole/vtcon1/name 2>/dev/null
        echo "--- pstore ---"; ls /sys/fs/pstore 2>/dev/null
        echo "--- dmesg tail ---"; dmesg 2>/dev/null | tail -50
        echo "===== ENDOF-LOG ====="
    } > /run/log.txt 2>/dev/null
    [ -s /run/log.txt ] || return 1
    head -c 1048576 /run/log.txt > /run/log.pad
    pad=$(( 1048576 - $(stat -c %s /run/log.pad) ))
    dd if=/dev/zero bs=131072 count=$(( (pad + 131071) / 131072 )) 2>/dev/null | dd bs=1 count="$pad" 2>/dev/null >> /run/log.pad
    blockdev --setrw "$d" 2>/dev/null
    dd if=/run/log.pad of="$d" bs=131072 seek=504 conv=notrunc,fsync 2>/dev/null
    blockdev --setro "$d" 2>/dev/null
}
(
    _i=0
    while [ "$_i" -lt 20 ] && ! find_bootdev; do sleep 1; _i=$((_i + 1)); done
    if find_bootdev; then
        mark "raw log channel live on /dev/$bootdev"
        logflush
    else
        mark 'raw log channel dead: no boot_a link in 20 s'
    fi
) &


ip addr add 172.16.42.1/24 dev usb0 2>/dev/null
ip link set usb0 up 2>/dev/null
cat > /run/udhcpd.conf <<'CONF'
start 172.16.42.2
end 172.16.42.2
interface usb0
option subnet 255.255.255.0
lease_file /run/udhcpd.leases
CONF
touch /run/udhcpd.leases
udhcpd /run/udhcpd.conf 2>/dev/null
mark 'dropbear start'
mkdir -p /etc/dropbear
dropbear -R -E -s -j -k -p 172.16.42.1:22
say 'SSH ready: root@172.16.42.1; all storage read-only'

# The guard's allowlist. First light ships it EMPTY: no partition may be
# written. A missing or non-empty file is not a license to write anything
# either - init fails closed and keeps every block read-only, logging why.
if [ ! -f /etc/omamobile-ufs-rw ]; then
    say 'allowlist /etc/omamobile-ufs-rw missing; keeping everything read-only'
elif [ -s /etc/omamobile-ufs-rw ]; then
    say 'allowlist not empty at first light; keeping everything read-only'
fi

# Every UFS block device (disks and partitions) goes read-only before
# anything mounts. A per-device failure is logged, never fatal here: the
# image never mounts anything but tmpfs, so a stubborn LUN stays unread.
mark 'storage guard pass 1'
storage_guard() {
    failed=0
    for s in /sys/class/block/sd*; do
        [ -e "$s" ] || continue
        name=${s##*/}
        [ -b "/dev/$name" ] || continue
        if ! blockdev --setro "/dev/$name" 2>&1; then
            say "FAILED to set /dev/$name read-only"
            failed=$((failed + 1))
        elif [ "$(cat "$s/ro" 2>/dev/null)" != 1 ]; then
            say "/dev/$name still reports rw after blockdev --setro"
            failed=$((failed + 1))
        fi
    done
    echo "$failed"
}
failed=$(storage_guard)
say "storage guard: $failed device(s) could not be write-protected"
mark 'storage guard pass 1 done'

# Re-assert the guard: a late-appearing LUN (or a rw flip) is caught the
# same way flame's probe does. At first light there is nothing to stop,
# so a failure re-arms everything and logs; it does not reboot the phone.
# The raw-log channel's own device is the one exempt write target (it is
# our image's partition; boot_b and every other LUN stay under the guard).
(
    while :; do
        for s in /sys/class/block/sd*; do
            [ -e "$s" ] || continue
            [ -n "$bootdev" ] && [ "$bootdev" = "${s##*/}" ] && continue
            [ "$(cat "$s/ro" 2>/dev/null)" = 1 ] || blockdev --setro "/dev/${s##*/}" 2>/dev/null
        done
        sleep 1
    done
) &

# Interactive shell on the kernel console (ttyMSM0 via cmdline console=)
# and on the ACM gadget port, so either cable sees the boot.
(
    while :; do
        setsid getty -n -l /bin/sh 115200 ttyMSM0 vt100
        sleep 1
    done
) &
(
    while :; do
        setsid getty -n -l /bin/sh 115200 ttyGS0 vt100
        sleep 1
    done
) &

mark 'init main flow complete; PID 1 parking'
# PID 1 never exits: a gone init is a panic, and a panic here (panic=10)
# just reboots back to whatever the bootloader picks. Stay RAM-only.
while :; do
    sleep 60
done
