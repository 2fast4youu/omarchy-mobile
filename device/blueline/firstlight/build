#!/bin/bash
# SPDX-License-Identifier: MIT
# Build a RAM-only Pixel 3 first-light boot image; never connect to or write a phone.
#
# Usage: device/blueline/firstlight/build --kernel Image.gz \
#          --dtb sdm845-google-blueline.dtb --ssh-key ~/.ssh/id_ed25519.pub \
#          --mkbootimg /path/to/mkbootimg.py --out /path/to/output \
#          [--panic-probe SECONDS] [--no-gadget] [--extra-cmdline KNOBS] \
#          [--docker-image alpine:3.22]
#
# --panic-probe arms init's timed sysrq-c panic (see init's probe block):
# the handset panics SECONDS after boot while provably alive, and the
# panic=10 warm reboot returns it to FASTBOOT MODE — the only aliveness
# instrument on a handset whose panel, gadget and ABOOT give nothing back.
#
# --no-gadget keeps the configfs skeleton but never writes the UDC bind;
# --extra-cmdline appends kernel knobs (e.g. omadwc3q=off). Both are
# bring-up bisect instruments and byte-asserted in the shipped header.
#
# The kernel must have UFS (ufs-qcom), USB DWC3/QCOM, configfs NCM/ACM,
# devtmpfs, tmpfs and ext4 built in; first light loads no modules. Supply
# the built sdm845-google-blueline.dtb, not a Dragonboard or Flame DTB: the
# container checks /model and /compatible before packing.
# mkbootimg.py comes from AOSP system/tools/mkbootimg. ABOOT on this
# generation takes a header-v2 image at the offsets proven in BRINGUP-M1
# (base 0, kernel 0x8000, ramdisk 0x1000000, tags 0x100, pagesize 4096)
# with the board DTB appended, not in the second stage.
# Docker runs a disposable aarch64 Alpine builder; x86 hosts need binfmt.
# The result is $out/firstlight.img, never named boot.img (M1.5 flashes it
# by hand to boot_b; this gate's name must not invite a blind fastboot
# flash boot).
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
kernel="" dtb="" key="" mkbootimg="" out="" image="alpine:3.22" panic_probe="" no_gadget="" extra_cmdline="" kernel_offset="" cmdline_replace=""
# Packer: v0 = das Layout, das auf diesem Haendler bootet (am Distributionsbild
# gemessen: Feld bei 40 = 0, Sektionen ohne jede Auffuellung, DTB an den Kernel
#anhaengt). v2 = der alte Pfad durch die mitgelieferte mkbootimg.py-Kopie; die
# schreibt --header_version an Offset 40, wo der von ABOOT gelesene Kopf die
# Seitengroesse traegt, und hat damit jeder bisherigen Messung den Boden
# entzogen. v0 ist deshalb Standard; --packer v2 haelt den Altpfad bereit.
packer=v0
packer_script="$ROOT/device/blueline/firstlight/pack-v0.py"
reference=""
die() { echo "error: $*" >&2; exit 1; }
while (($#)); do
  case $1 in
    --kernel) kernel=${2:?}; shift ;;
    --dtb) dtb=${2:?}; shift ;;
    --ssh-key) key=${2:?}; shift ;;
    --mkbootimg) mkbootimg=${2:?}; shift ;;
    --out) out=${2:?}; shift ;;
    --docker-image) image=${2:?}; shift ;;
    --panic-probe) panic_probe=${2:?}; shift ;;
    --no-gadget) no_gadget=1 ;;
    --extra-cmdline) extra_cmdline=${2:?}; shift ;;
    --kernel-offset) kernel_offset=${2:?}; shift ;;
    --cmdline-replace) cmdline_replace=${2:?}; shift ;;
    --packer) packer=${2:?}; shift ;;
    --packer-script) packer_script=${2:?}; shift ;;
    --reference) reference=${2:?}; shift ;;
    -h|--help) sed -n '3,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done
command -v docker >/dev/null || die 'Docker is required'
command -v python3 >/dev/null || die 'Python 3 is required'
for path in "$kernel" "$dtb" "$key"; do
  [[ -n $path && -f $path ]] || die 'supply --kernel, --dtb and --ssh-key files'
done
case $packer in
  v0) ;;
  v2) [[ -n ${mkbootimg:-} && -f ${mkbootimg:-} ]] || die '--packer v2 needs --mkbootimg (a file)' ;;
  *) die "unknown --packer: $packer (v0 or v2)" ;;
esac
[[ -z $reference || -f $reference ]] || die '--reference must be a readable boot image'
[[ -n $out ]] || die 'supply --out DIR'

# Normalize paths portably (macOS realpath lacks -m/-f on older releases),
# so relative paths and spaces survive Docker's bind mount parsing.
absolute() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }
kernel=$(absolute "$kernel") dtb=$(absolute "$dtb") key=$(absolute "$key")
out=$(absolute "$out")
[[ -z ${mkbootimg:-} ]] || mkbootimg=$(absolute "$mkbootimg")
packer_script=$(absolute "$packer_script")
[[ -f $packer_script ]] || die "--packer-script must name an existing packer, not $packer_script"
[[ -z $reference ]] || reference=$(absolute "$reference")
check_paths=("$ROOT" "$kernel" "$dtb" "$key" "$packer_script" "$out")
[[ -z ${mkbootimg:-} ]] || check_paths+=("$mkbootimg")
[[ -z ${reference:-} ]] || check_paths+=("$reference")
for path in "${check_paths[@]}"; do
  [[ $path != *,* ]] || die 'Docker bind paths cannot contain commas'
done
[[ $packer != v2 || $(basename "$mkbootimg") == mkbootimg.py ]] ||
  die '--mkbootimg must name AOSP mkbootimg.py'
[[ ! -e $out/firstlight.img ]] || die "$out/firstlight.img already exists; remove it or choose another output directory"
python3 - "$key" <<'PY'
import base64, pathlib, struct, sys
data = pathlib.Path(sys.argv[1]).read_text().split()
if len(data) < 2 or data[0] not in ('ssh-ed25519', 'ssh-rsa', 'ecdsa-sha2-nistp256'):
    sys.exit('--ssh-key must be an OpenSSH PUBLIC key, never a private key')
try:
    raw = base64.b64decode(data[1], validate=True)
    n, = struct.unpack('>I', raw[:4])
    assert raw[4:4+n].decode() == data[0]
except (ValueError, struct.error, AssertionError, UnicodeError):
    sys.exit('invalid SSH public key')
PY

mkdir -p "$out"
# Panic probe: seconds until a sysrq-c panic with no gadget present; empty
# disables it. See init's panic-probe block for why this is the only
# kernel-aliveness instrument on this handset.
docker run --rm --platform linux/arm64 \
  -e "OMAMOBILE_PANIC_PROBE=${panic_probe:-}" \
  -e "OMAMOBILE_NO_GADGET=${no_gadget:-}" \
  -e "OMAMOBILE_EXTRA_CMDLINE=${extra_cmdline:-}" \
  -e "OMAMOBILE_KERNEL_OFFSET=${kernel_offset:-}" \
  -e "OMAMOBILE_CMDLINE_REPLACE=${cmdline_replace:-}" \
  --mount "type=bind,source=$ROOT,target=/src,readonly" \
  --mount "type=bind,source=$kernel,target=/input/kernel,readonly" \
  --mount "type=bind,source=$dtb,target=/input/blueline.dtb,readonly" \
  --mount "type=bind,source=$key,target=/input/key.pub,readonly" \
  ${mkbootimg:+--mount "type=bind,source=$(dirname "$mkbootimg"),target=/mkbootimg,readonly"} \
  -e "OMAMOBILE_PACKER=$packer" \
  --mount "type=bind,source=$packer_script,target=/packer/packer.py,readonly" \
  ${reference:+--mount "type=bind,source=$reference,target=/packer/reference.img,readonly"} \
  --mount "type=bind,source=$out,target=/out" \
  "$image" sh /src/device/blueline/firstlight/initramfs/build
echo "Built $out/firstlight.img (RAM-only first light; no phone was accessed)"
