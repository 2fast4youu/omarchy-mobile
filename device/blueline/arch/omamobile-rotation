#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omamobile
case "${1:-}" in
    status)
        if ! busctl --timeout=2 get-property net.hadess.SensorProxy /net/hadess/SensorProxy \
            net.hadess.SensorProxy HasAccelerometer 2>/dev/null | grep -qx 'b true'; then
            echo none
        elif [[ -e $state_dir/rotation-lock ]]; then
            echo locked
        else
            echo auto
        fi
        ;;
    lock) mkdir -p "$state_dir"; touch "$state_dir/rotation-lock" ;;
    unlock) rm -f "$state_dir/rotation-lock" ;;
    *) exit 2 ;;
esac
