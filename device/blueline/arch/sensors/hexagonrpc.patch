diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..8e01581 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -113,0 +114,31 @@ static void destroy_file_descriptor(struct hexagonfs_fd *fd)
+int hexagonfs_open_registry(struct hexagonfs_fd **fds, int directory,
+                           const char *name, int flags)
+{
+    if (directory < 0 || !*name || strchr(name, '/') ||
+        !strcmp(name, ".") || !strcmp(name, ".."))
+        return -EINVAL;
+
+    struct hexagonfs_fd *dir = fds[directory];
+    if (!dir || dir->ops != &hexagonfs_mapped_ops)
+        return -EINVAL;
+
+    struct hexagonfs_fd *file;
+    int result = hexagonfs_mapped_write_open(dir, name, flags, &file);
+    if (result)
+        return result;
+
+    result = allocate_file_number(fds, file);
+    if (result < 0)
+        destroy_file_descriptor(file);
+    return result;
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size,
+                       const void *data)
+{
+    if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD || !fds[fileno] ||
+        fds[fileno]->ops != &hexagonfs_mapped_ops)
+        return -EBADF;
+    return hexagonfs_mapped_write(fds[fileno], size, data);
+}
+
diff --git a/hexagonrpcd/hexagonfs.h b/hexagonrpcd/hexagonfs.h
index 7682604..e13c1b0 100644
--- a/hexagonrpcd/hexagonfs.h
+++ b/hexagonrpcd/hexagonfs.h
@@ -65,0 +66,7 @@ struct hexagonfs_fd {
+int hexagonfs_open_registry(struct hexagonfs_fd **fds, int directory,
+                           const char *name, int flags);
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size,
+                       const void *data);
+int hexagonfs_mapped_write_open(struct hexagonfs_fd *dir, const char *name,
+                              int flags, struct hexagonfs_fd **out);
+ssize_t hexagonfs_mapped_write(struct hexagonfs_fd *file, size_t size, const void *data);
diff --git a/hexagonrpcd/hexagonfs_mapped.c b/hexagonrpcd/hexagonfs_mapped.c
index fd28c8c..a822777 100644
--- a/hexagonrpcd/hexagonfs_mapped.c
+++ b/hexagonrpcd/hexagonfs_mapped.c
@@ -128,0 +129,36 @@ err:
+int hexagonfs_mapped_write_open(struct hexagonfs_fd *dir, const char *name,
+                              int flags, struct hexagonfs_fd **out)
+{
+    struct mapped_ctx *parent = dir->data;
+    struct mapped_ctx *ctx = calloc(1, sizeof(*ctx));
+    if (!ctx)
+        return -ENOMEM;
+
+    struct hexagonfs_fd *file = calloc(1, sizeof(*file));
+    if (!file) {
+        free(ctx);
+        return -ENOMEM;
+    }
+
+    ctx->fd = openat(parent->fd, name, flags | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (ctx->fd < 0) {
+        int error = -errno;
+        free(file);
+        free(ctx);
+        return error;
+    }
+
+    file->up = dir;
+    file->ops = &hexagonfs_mapped_ops;
+    file->data = ctx;
+    *out = file;
+    return 0;
+}
+
+ssize_t hexagonfs_mapped_write(struct hexagonfs_fd *file, size_t size, const void *data)
+{
+    struct mapped_ctx *ctx = file->data;
+    ssize_t written = write(ctx->fd, data, size);
+    return written < 0 ? -errno : written;
+}
+
