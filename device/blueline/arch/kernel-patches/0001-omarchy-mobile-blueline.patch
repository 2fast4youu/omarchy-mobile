+/*
+ * Omarchy Mobile: libcamera's simple pipeline asks for the sensor crop
+ * rectangles. Without get_selection it aborts with "Unable to get
+ * rectangle". The sensor is used full-frame, so crop == mode size.
+ */
+static int imx355_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx355 *imx355 = to_imx355(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		mutex_lock(&imx355->mutex);
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = imx355->cur_mode->width;
+		sel->r.height = imx355->cur_mode->height;
+		mutex_unlock(&imx355->mutex);
+		return 0;
+
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = imx355->cur_mode->width;
+		sel->r.height = imx355->cur_mode->height;
+		return 0;
+	}
+
+	return -EINVAL;
+}
