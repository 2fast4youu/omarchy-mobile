UUID = "8a1e65d9-812b-4c53-8936-e8ea3f67050f"
PROFILE = "/org/omamobile/BluetoothControl"
BLUEZ = "org.bluez"
DEVICE = "org.bluez.Device1"
PROPS = "org.freedesktop.DBus.Properties"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "omamobile/bluetooth-controller"
TORCH = Path("/sys/class/leds/white:flash/brightness")
APPS = {"camera": "omacam", "files": "org.gnome.Nautilus"}


def command(*arguments):
    return subprocess.run(arguments, cwd=Path.home(), capture_output=True, text=True,
                          check=True, timeout=8).stdout.strip()


def act(request):
    if not isinstance(request, dict):
        raise ValueError("Ungültiger Auftrag")
    action = request.get("action")
    if action == "status":
        return {"torch": int(TORCH.read_text()) > 0}
    if action == "torch" and type(request.get("enabled")) is bool:
        level = 64 if request["enabled"] else 0
        TORCH.write_text(f"{level}\n")
        return {"torch": int(TORCH.read_text()) > 0}
    if action == "open" and isinstance(request.get("app"), str) and request["app"] in APPS:
        command("omamobile-launch", "app", APPS[request["app"]])
        return {"message": "App angefordert"}
    if action == "hermes" and isinstance(request.get("prompt"), str):
        prompt = request["prompt"].strip()
        if not prompt or len(prompt) > 1500:
            raise ValueError("Schreib einen Auftrag mit bis zu 1500 Zeichen")
        command("/usr/local/bin/omarchy-install-hermes-cli", "--check")
        hermes = Path.home() / ".local/bin/hermes"
        command("omamobile-launch", "cmd", "--", "foot", "--app-id=org.omamobile.Hermes",
                str(hermes), "chat", "--tui", f"--query={prompt}")
        return {"message": "Auftrag an Hermes auf dem Pixel übergeben"}
    raise ValueError("Diese Aktion ist auf dem Pixel nicht verfügbar")


def configured_peer():
    try:
        return CONFIG.read_text(encoding="ascii").strip()
    except FileNotFoundError:
        return None


def terminal(connection, authorized):
    master, slave = pty.openpty()
    try:
        try:
            fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 32, 80, 0, 0))
            shell = subprocess.Popen(["/usr/bin/setsid", "--ctty", "/usr/bin/bash", "-i"],
                                     stdin=slave, stdout=slave, stderr=slave, cwd=Path.home(),
                                     env={**os.environ, "TERM": "dumb", "NO_COLOR": "1"})
        finally:
            os.close(slave)
        try:
            connection.settimeout(10)
            connection.sendall(b'{"ok":true}\n')
            with selectors.DefaultSelector() as selector:
                selector.register(connection, selectors.EVENT_READ)
                selector.register(master, selectors.EVENT_READ)
                while authorized():
                    for key, _ in selector.select(timeout=1):
                        if key.fileobj is connection:
                            pending = memoryview(connection.recv(8192))
                            if not pending:
                                return
                            while pending:
                                pending = pending[os.write(master, pending):]
                        else:
                            output = os.read(master, 8192)
                            if not output:
                                return
                            connection.sendall(output)
        except OSError:
            # An exited shell ends its PTY with EIO, and a disconnected client
            # ends the RFCOMM write. Both terminate this session.
            pass
        finally:
            if shell.poll() is None:
                with suppress(ProcessLookupError):
                    os.killpg(shell.pid, signal.SIGHUP)
                try:
                    shell.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    shell.kill()
                    shell.wait()
    finally:
        os.close(master)


def communicate(connection, authorized=lambda: True):
    with connection, connection.makefile("rb") as reader:
        connection.settimeout(180)
        while True:
            line = reader.readline(12289)
            if not line:
                return
            if len(line) > 12288 or not line.endswith(b"\n"):
                connection.sendall(b'{"ok":false,"error":"Auftrag zu lang"}\n')
                return
            if not authorized():
                connection.sendall(b'{"ok":false,"error":"Steuerung am Pixel deaktiviert"}\n')
                return
            try:
                request = json.loads(line.decode("utf-8"))
                if isinstance(request, dict) and request.get("action") == "terminal":
                    terminal(connection, authorized)
                    return
                answer = {"ok": True, **act(request)}
            except (ValueError, UnicodeError) as error:
                answer = {"ok": False, "error": str(error)}
            except (OSError, subprocess.SubprocessError):
                answer = {"ok": False, "error": "Das Pixel konnte die Aktion nicht ausführen"}
            connection.sendall(json.dumps(answer, ensure_ascii=False).encode("utf-8") + b"\n")


class Profile(dbus.service.Object):
    def __init__(self, bus, loop):
        super().__init__(bus, PROFILE)
        self.bus = bus
        self.loop = loop
        self.active = None
        self.lock = threading.Lock()

    def identify_bluez(self, sender):
        if sender != self.bus.get_name_owner(BLUEZ):
            raise dbus.exceptions.DBusException("Unexpected sender", name="org.bluez.Error.Rejected")

    @dbus.service.method("org.bluez.Profile1", in_signature="oha{sv}", sender_keyword="sender")
    def NewConnection(self, device, fd, properties, sender=None):
        self.identify_bluez(sender)
        props = dbus.Interface(self.bus.get_object(BLUEZ, device), PROPS).GetAll(DEVICE, timeout=3)
        peer = str(props.get("Address", "")).upper()
        if not peer or peer != configured_peer() or not props.get("Bonded"):
            raise dbus.exceptions.DBusException("Controller not selected", name="org.bluez.Error.Rejected")
        with self.lock:
            if self.active is not None:
                raise dbus.exceptions.DBusException("Controller already connected", name="org.bluez.Error.Rejected")
            connection = socket.socket(fileno=fd.take())
            self.active = connection
        threading.Thread(target=self.serve, args=(connection, peer), daemon=True).start()

    def serve(self, connection, peer):
        try:
            communicate(connection, lambda: peer == configured_peer())
        except OSError:
            pass
        finally:
            with self.lock:
                self.active = None

    @dbus.service.method("org.bluez.Profile1", in_signature="o", sender_keyword="sender")
    def RequestDisconnection(self, device, sender=None):
        self.identify_bluez(sender)
        with self.lock:
            if self.active is not None:
                try:
                    self.active.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass

    @dbus.service.method("org.bluez.Profile1", sender_keyword="sender")
    def Release(self, sender=None):
        self.identify_bluez(sender)
        self.loop.quit()


def choose_peer(bus):
    objects = dbus.Interface(bus.get_object(BLUEZ, "/"), "org.freedesktop.DBus.ObjectManager")
    devices = [interfaces[DEVICE] for interfaces in objects.GetManagedObjects().values()
               if DEVICE in interfaces and interfaces[DEVICE].get("Bonded")]
    if not devices:
        raise SystemExit("Kopple zuerst das andere Gerät in den Bluetooth-Einstellungen des Pixels.")
    for index, device in enumerate(devices, 1):
        print(f"{index}. {device['Alias']}")
    chosen = input("Nummer des Geräts eingeben: ").strip()
    if not chosen.isdecimal() or not 1 <= int(chosen) <= len(devices):
        raise SystemExit("Wähle die Nummer des gekoppelten Steuergeräts.")
    return str(devices[int(chosen) - 1]["Address"]).upper()


def allow_controller(bus):
    peer = choose_peer(bus)
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    temporary = CONFIG.with_suffix(".next")
    temporary.write_text(peer + "\n", encoding="ascii")
    temporary.chmod(0o600)
    temporary.replace(CONFIG)
    print("Das gewählte Gerät darf jetzt Aktionen auslösen.")


def nmcli(*args):
    try:
        result = subprocess.run(["nmcli", "--wait", "25", "--terse", "--escape", "no", *args],
                                capture_output=True, text=True, timeout=28)
    except subprocess.TimeoutExpired:
        raise SystemExit("NetworkManager hat nicht rechtzeitig geantwortet.") from None
    if result.returncode:
        errors = result.stderr.strip().splitlines()
        raise SystemExit(errors[0] if errors else "Die Bluetooth-Verbindung konnte nicht geändert werden.")
    return result.stdout.strip()


def bluetooth_internet(bus):
    print("Wähle das gekoppelte Handy, das mobile Daten per Bluetooth freigibt.")
    peer = choose_peer(bus)
    profile = None
    for connection in nmcli("--fields", "TYPE,UUID", "connection", "show").splitlines():
        kind, _, candidate = connection.partition(":")
        if kind != "bluetooth":
            continue
        details = nmcli("--get-values", "bluetooth.type,bluetooth.bdaddr", "connection", "show", "uuid", candidate)
        if details.splitlines() == ["panu", peer]:
            profile = candidate
            break

    action = input("1. Verbinden und automatisch nutzen\n2. Trennen\nAuswahl: ").strip()
    active = nmcli("--fields", "UUID", "connection", "show", "--active").splitlines()
    if action == "2":
        if profile:
            nmcli("connection", "modify", "uuid", profile, "connection.autoconnect", "no")
            if profile in active:
                nmcli("connection", "down", "uuid", profile)
        print("Bluetooth-Internet ist aus.")
        return
    if action != "1":
        raise SystemExit("Wähle 1 oder 2.")
    if profile is None:
        profile = str(uuid.uuid4())
        nmcli("connection", "add", "type", "bluetooth", "ifname", "*", "con-name", "Bluetooth-Internet",
              "connection.uuid", profile,
              "bluetooth.type", "panu", "bluetooth.bdaddr", peer, "connection.autoconnect", "no",
              "ipv4.route-metric", "700", "ipv6.route-metric", "700")
    if profile not in active:
        try:
            nmcli("connection", "up", "uuid", profile)
        except SystemExit as error:
            raise SystemExit(f"{error}\nPrüfe mobile Daten und Bluetooth-Tethering am anderen Gerät.") from None
    nmcli("connection", "modify", "uuid", profile, "connection.autoconnect", "yes")
    print("Bluetooth-Internet ist verbunden. WLAN hat Vorrang.")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("mode", choices=("allow", "serve", "probe", "setup", "disable", "internet"))
    args = parser.parse_args()
    if os.geteuid() == 0:
        raise SystemExit("Starte die Bluetooth-Steuerung aus der Pixel-Sitzung.")
    if args.mode == "disable":
        CONFIG.unlink(missing_ok=True)
        return
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    if args.mode == "internet":
        try:
            bluetooth_internet(bus)
        finally:
            if sys.stdin.isatty():
                input("Enter zum Schließen.")
        return
    if args.mode in {"allow", "setup"}:
        allow_controller(bus)
        if args.mode == "setup":
            log = Path(os.environ["XDG_RUNTIME_DIR"]) / "blueline-bluetooth.log"
            with log.open("a", encoding="utf-8") as output:
                subprocess.Popen([sys.executable, __file__, "serve"], start_new_session=True,
                                 stdin=subprocess.DEVNULL, stdout=output, stderr=output)
        return
    if args.mode == "serve" and not configured_peer():
        raise SystemExit("Wähle zuerst auf dem Pixel das gekoppelte Steuergerät aus.")
    lock = None
    if args.mode == "serve":
        lock_file = Path(os.environ["XDG_RUNTIME_DIR"]) / "blueline-bluetooth.lock"
        lock = lock_file.open("w", encoding="ascii")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
    loop = GLib.MainLoop()
    profile = Profile(bus, loop)
    manager = dbus.Interface(bus.get_object(BLUEZ, "/org/bluez"), "org.bluez.ProfileManager1")
    manager.RegisterProfile(PROFILE, UUID, {"Name": "Omarchy Pixel-Steuerung", "Role": "server",
                                           "RequireAuthentication": dbus.Boolean(True)})
    print("Bluetooth-Steuerung ist bereit.", flush=True)
    if args.mode == "serve":
        loop.run()
    manager.UnregisterProfile(PROFILE)
    profile.remove_from_connection()


if __name__ == "__main__":
    main()
